// GenLink persistence schema for projects, canvas nodes, and canvas edges.

generator client {
  provider        = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Project {
  id        String       @id @default(cuid())
  name      String
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  canvases  Canvas[]
  nodes     CanvasNode[]
  edges     CanvasEdge[]
}

model Canvas {
  id        String       @id
  projectId String
  name      String
  position  Int          @default(0)
  viewport  String
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  project   Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  nodes     CanvasNode[]
  edges     CanvasEdge[]

  @@index([projectId, position])
}

model CanvasNode {
  id        String   @id
  projectId String
  canvasId  String
  type      String
  positionX Float
  positionY Float
  data      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  canvas    Canvas   @relation(fields: [canvasId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([canvasId])
}

model CanvasEdge {
  id           String   @id
  projectId    String
  canvasId     String
  source       String
  target       String
  sourceHandle String?
  targetHandle String?
  createdAt    DateTime @default(now())
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  canvas       Canvas   @relation(fields: [canvasId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([canvasId])
}

model ImageJob {
  id        String   @id
  status    String
  provider  String?
  upstreamTaskId String?
  historyNodeData String?
  result    String?
  error     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
  @@index([upstreamTaskId])
}

model ImageHistoryItem {
  id             String   @id @default(cuid())
  imageJobId     String?
  resultIndex    Int?
  imageUrl       String
  hostedImageUrl String?
  model          String?
  width          Int?
  height         Int?
  format         String?
  sizeBytes      Int?
  generatedAt    DateTime
  nodeData       String
  createdAt      DateTime @default(now())

  @@index([generatedAt])
}

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean
  image         String?
  createdAt     DateTime
  updatedAt     DateTime
  sessions      Session[]
  accounts      Account[]
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime

  @@index([userId])
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@index([identifier])
}

model RegistrationCodeRequest {
  id        String   @id
  email     String
  createdAt DateTime @default(now())

  @@index([email, createdAt])
}
